# Copy to .env.local for `npm run dev` against a locally running go-api
# (docker-compose.dev.yml exposes it on :8080 with
# CORS_ALLOWED_ORIGIN=http://localhost:5173 already set for this). Leave
# unset in production: the default in src/api/env.ts is a relative
# `/api/v1`, resolved against whatever origin Caddy serves the SPA from.
VITE_API_BASE_URL=http://localhost:8080/api/v1
