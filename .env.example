# --- core ---
APP_ENV=development
APP_BASE_URL=https://example.com
LOG_LEVEL=info
API_HTTP_PORT=8080
CORS_ALLOWED_ORIGIN=https://example.com

# --- postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vocalcoach
POSTGRES_USER=vocalcoach
POSTGRES_PASSWORD=

# --- redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- auth ---
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- smtp ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- limits ---
MAX_UPLOAD_MB=15
MAX_AUDIO_SECONDS=360
QUEUE_MAX_LENGTH=20
USER_ANALYSES_PER_HOUR=10
AUDIO_TTL_SECONDS=300

# --- ml ---
PITCH_ENGINE=crepe          # crepe | pyin
WHISPER_MODEL=base   # small overruns TRANSCRIBE_TIMEOUT_SECONDS on real hardware, ADR-0014
WHISPER_COMPUTE_TYPE=int8   # faster-whisper's CTranslate2 quantization, ADR-0021
DEMUCS_MODEL=htdemucs
SCORING_VERSION=2.0
# Two profiles, not one (spec 6.14): mixed scores fewer aspects (no
# breath/timbre, spec 6.5) at different weights, not a subset of clean's own.
SCORING_WEIGHTS_CLEAN=pitch:0.35,rhythm:0.20,breath:0.15,dynamics:0.10,vibrato:0.10,timbre:0.10
SCORING_WEIGHTS_MIXED=pitch:0.50,rhythm:0.30,dynamics:0.10,vibrato:0.10

# --- ml: mixed mode (spec 6.6, 6.8, 6.16, M3) ---
# median(RMS of unvoiced frames) / median(RMS of voiced frames) at or above
# this flags likely accompaniment (A3); below it in a declared `mixed`
# analysis auto-downgrades to `clean` (FR-29).
ACCOMPANIMENT_DETECT_THRESHOLD=0.15
# A8 key-shift normalization (spec 6.8): the conditions guarding against
# pardoning real off-pitch singing as "just transposed".
KEY_SHIFT_MIN_SEMITONES=0.6
KEY_SHIFT_MAX_IQR=0.5
MAX_KEY_SHIFT_SEMITONES=7

# --- ml: worker runtime (spec 6.11, NFR-18) ---
# 0 = autodetect from the container's cgroup CPU limit, not the host's core count.
WORKER_CPU_THREADS=0
# spec 6.10: off only for deterministic tests that need an exact stage order.
PIPELINE_PARALLEL_ASPECTS=true

# --- features ---
# spec 11.4: YouTube import is personal/non-commercial use only -- web/
# shows the disclaimer before the URL field every time that tab is
# selected. See docs/adr/0028-enable-youtube-import-by-default.md.
FEATURE_YOUTUBE_IMPORT=true
# Base URL of the PO Token provider sidecar yt-dlp calls use to pass
# YouTube's bot-check (ADR-0037). Default matches the `pot-provider`
# compose service name/port -- only override for a sidecar running
# somewhere other than this compose network.
YOUTUBE_POT_PROVIDER_URL=http://pot-provider:4416
